<div class="wrapper row3">
  <section class="hoc container clear"> 
    <!-- ################################################################################################ -->
    <!-- #BeginEditable "content%20region" -->
    <div class="three_quarter first">
      <h3 class="nospace">ஐந்நூற்றுவர் இணைய தளம் </h3>
     <!-- <p class="nospace"> -->
      <ul>
      	<li>நமது சமூகத்தின் பாரம்பரியம் மற்றும் வரலாறு  பற்றிய தகவல்கள் </li>
      	<br>
      	<li>நமது எம்மாம்பூண்டி ஐந்நூற்று செட்டிமார் சபை பற்றிய விபரங்கள் மற்றும் நிர்வாக அமைப்பு</li>
      	<br>					
		<li>நமது சமூகத்தின் விற்றூணியார் மற்றும் குல தெய்வக் கோவில்கள் பற்றிய தகவல்கள்</li>	
		<br>				
		<li>முக்கியமான கடவுள் வழிபாட்டு பாடல்கள்</li>	
		<br>				
		<li>நம் சமூகத்தில்  திருமணம் மற்றும் அது சார்ந்த சீர்கள் செய்யும் முறைகள் </li>
		<br>
		<li> ஊஞ்சல் பாட்டு, திருமண சாமான்கள் பற்றிய விபரங்கள்</li>	
		<br>			
		<li>திருமணம் தவிர மற்ற விசேஷங்கள் செய்யும் முறைகள்</li>
		<br>
		<li> பண்டிகைகள் கொண்டாடும் வழி முறைகள்</li>
		<br>				
		<li>பிற காரியங்கள் செய்யும் முறைகள், தேவையான சாமான்கள்	</li>
	</ul>					
<!-- </p>  -->
